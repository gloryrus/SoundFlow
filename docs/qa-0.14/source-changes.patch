nt(MainActivity.this,AccountWebActivity.class).putExtra("op",op).putExtra("track",track).putExtra("playlist",playlist).putExtra("title",title).putExtra("auto",false),71));dialog.show();}});toast("Отправляем изменение…");accountWriter.submit(op,track,playlist,title);}
 
  private void apiAccessInfo(){new AlertDialog.Builder(this).setTitle("Доступ к записи SoundCloud").setMessage("Лайки и плейлисты отправляются в api-v2.soundcloud.com с той же сессией и client_id, что используются для чтения библиотеки. Сторонний сервер и чужие секреты не используются. Это неофициальный веб-API: SoundCloud может изменить его или отклонить запрос.\n\nHTTP 403 не доказывает отсутствие зарегистрированного приложения. Повторный ввод пароля не гарантирует исправления. Если результат запроса неизвестен, проверьте библиотеку на сайте перед повтором.").setPositiveButton("Понятно",null).show();}
